{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build EV Charging System",
            "command": "g++",
            "args": [
                "-std=c++11",
                "-g",
                "main.cpp",
                "EVC_System/Source Files/Models.cpp",
                "EVC_System/Source Files/Managers.cpp",
                "EVC_System/Source Files/UI.cpp",
                "-I.",
                "-I${workspaceFolder}/EVC_System/Header Files",
                "-IC:/raylib/raylib/src",
                "-LC:/raylib/raylib/src",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm",
                "-o",
                "${workspaceFolder}/EVC_System.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Biên dịch toàn bộ dự án EV Charging System"
        }
    ]
}